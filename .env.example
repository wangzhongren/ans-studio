# 环境变量示例（可入库）。真实值填进 .env，该文件已被 .gitignore 忽略。
# 用法：node --env-file=.env bin/ans.js role run 编排 --task T-1 --runtime pi

# —— 运行时选择 ——
# demo（不调模型） | pi | codex | claude
# 留空：role run 默认 demo，govern 默认 pi。命令行 --runtime 优先于此项。
ANS_RUNTIME=

# —— Pi provider ——
# 端点与模型**无默认值**：缺失即明确失败，绝不回落到任何端点。
ANS_PI_BASE_URL=
ANS_PI_MODEL=
# provider 标识（**内部标签**，代码缺省 ans-gateway）。**不在桌面面板里**，但底层仍支持该环境变量。
ANS_PI_PROVIDER=ans-gateway
# 真实模型的上下文窗口（tokens）。**可选**：留空 = Pi适配器用**保守默认值 32768**（缺失**不硬失败**，
# 只在日志与事件流给一条可见提示）；知道确切值就填，覆盖默认。示例：131072
# 为何默认偏保守：须**严格大于** Pi 压缩的 reserveTokens（16384），否则压缩阈值 ≤ 0、几乎每轮触发而退化；
# 且宁可偏小（压缩提前，良性）不可偏大（窗口设大使长会话炸掉）。
ANS_PI_CONTEXT_WINDOW=

# —— 凭据 ——
# 只通过环境变量传入。绝不要写进任何入库文件。
ANTHROPIC_AUTH_TOKEN=

# —— Codex（实际 codex app-server；API 端点须兼容 Responses） ——
# API key 和模型必填。优先 CODEX_API_KEY；已有 OPENAI_API_KEY 时可留空前者。
# 不使用或修改全局登录状态；不接受订阅/OAuth 作为本产品配置。
CODEX_API_KEY=
OPENAI_API_KEY=
ANS_CODEX_MODEL=
# 可选，不声明此键时使用 https://api.openai.com/v1；自定义时取消注释并填写完整地址。
# ANS_CODEX_BASE_URL=https://api.openai.com/v1

# —— Claude（官方 Agent SDK + SDK MCP） ——
# API key 必填，不回落到 ANTHROPIC_AUTH_TOKEN 或订阅/OAuth。
ANTHROPIC_API_KEY=
# 模型、API 地址可选，留空使用 SDK 默认值。
ANS_CLAUDE_MODEL=
ANTHROPIC_BASE_URL=
