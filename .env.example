# 环境变量示例（可入库）。真实值填进 .env，该文件已被 .gitignore 忽略。
# 用法：node --env-file=.env bin/ans.js role run 编排 --task T-1 --runtime pi

# —— 运行时选择 ——
# demo（默认，不调模型，走装配的演示假 runtime） | pi（真实调用 Pi）
ANS_RUNTIME=demo

# 允许发出真实网络请求。未设置时不得发出任何真实请求。
ANS_PI_ALLOW_REAL=

# —— Pi provider（无默认值；缺失即明确失败，绝不回落到任何端点）——
ANS_PI_BASE_URL=
ANS_PI_MODEL=
# provider 标识，缺省 ans-gateway
ANS_PI_PROVIDER=ans-gateway
# 真实模型的上下文窗口（tokens）。**必填，无默认值**：缺失即明确失败（fail-closed），
# 与 baseUrl/model 同一策略，绝不回落到模板值。模型克隆自 anthropic 模板，其 contextWindow
# 为 1,000,000，与网关上的真实模型无关；沿用模板值会让 Pi 的自动上下文压缩阈值永远够不着，
# 长会话会先收到服务端超长报错，而不是优雅压缩。请填写网关真实模型的上下文窗口。示例：131072
ANS_PI_CONTEXT_WINDOW=

# —— 凭据 ——
# 只通过环境变量传入。绝不要写进任何入库文件。
ANTHROPIC_AUTH_TOKEN=
