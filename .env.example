# 环境变量示例（可入库）。真实值填进 .env，该文件已被 .gitignore 忽略。
# 用法：node --env-file=.env bin/ans.js role run 编排 --task T-1 --runtime pi

# —— 运行时选择 ——
# demo（默认，不调模型，走装配的演示假 runtime） | pi（真实调用 Pi）
ANS_RUNTIME=demo

# 允许发出真实网络请求。未设置时不得发出任何真实请求。
ANS_PI_ALLOW_REAL=

# —— Pi provider ——
# 端点与模型**无默认值**：缺失即明确失败，绝不回落到任何端点。
ANS_PI_BASE_URL=
ANS_PI_MODEL=
# provider 标识（**内部标签**，代码缺省 ans-gateway）。**不在桌面面板里**，但底层仍支持该环境变量。
ANS_PI_PROVIDER=ans-gateway
# 真实模型的上下文窗口（tokens）。**可选**：留空 = Pi适配器用**保守默认值 32768**（缺失**不硬失败**，
# 只在日志与事件流给一条可见提示）；知道确切值就填，覆盖默认。示例：131072
# 为何默认偏保守：须**严格大于** Pi 压缩的 reserveTokens（16384），否则压缩阈值 ≤ 0、几乎每轮触发而退化；
# 且宁可偏小（压缩提前，良性）不可偏大（窗口设大使长会话炸掉）。
ANS_PI_CONTEXT_WINDOW=

# —— 凭据 ——
# 只通过环境变量传入。绝不要写进任何入库文件。
ANTHROPIC_AUTH_TOKEN=
