+export function validateAcceptanceCriteriaText(text: string, flowId: string): AcceptanceCriteriaCheck {
+  const issues: string[] = [];
+  if (typeof text !== "string" || text.trim() === "") {
+    return { ok: false, issues: ["标准文件为空"] };
+  }
+  const frontmatter = /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/.exec(text);
+  if (frontmatter !== null) {
