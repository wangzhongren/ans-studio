+      `flowId: ${flowId}`,
+      "version: 1",
+      "status: draft",
+      "riskTier: T3",
+      `recommended: [${recommended.join(", ")}]`,
+      "---",
+      "",
+      `# 团队计划：${flowId}`,
+      "",
+      "| roleId | 类型 | 职责目标 | 能力要求 | 唯一写集 | 依赖 | 组别 | apiSpec |",
+      "| --- | --- | --- | --- | --- | --- | --- | --- |",
+      ...recommended.map((id) => `| ${id} | existing | 实现 ${id} | 具备 ${id} 能力 | src/${id}/ | 无 | 组 A | not-applicable |`),
+      "",
+    ].join("\n"),
+    "utf8",
+  );
+}
