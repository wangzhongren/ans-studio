+  raw: string;
+  /** 规范化项目相对路径（反斜杠→`/`、去掉 `./`；目录保留结尾 `/`）。 */
+  path: string;
+  /** 是否目录（以 `/` 结尾）。 */
+  directory: boolean;
+}
