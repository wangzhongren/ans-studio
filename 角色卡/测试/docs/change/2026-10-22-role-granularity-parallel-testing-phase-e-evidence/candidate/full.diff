+const CONSISTENT_FLOW = `flowId: flow-a
+version: 1
+qualityTier: production
+steps:
+  - id: contract-freeze
+    title: 冻结契约
+    owner: convener
+    kind: artifact
+    status: done
+    evidence: { kind: artifact, ref: docs/contracts/api-v1.md }
+  - id: delivery-api
+    title: Map A｜api
+    owner: api
+    kind: dispatch
+    status: pending
+    parallelGroup: map-a
+    dependsOn: [contract-freeze]
+  - id: delivery-storefront
+    title: Map B｜storefront
+    owner: storefront
+    kind: dispatch
+    status: pending
+    parallelGroup: map-b
+    dependsOn: [contract-freeze, delivery-api]
+  - id: test-map-shards
+    title: Map 测试分片
+    owner: integration
+    kind: dispatch
+    status: pending
+    parallelGroup: reduce
+    dependsOn: [delivery-api, delivery-storefront]
+  - id: verification-evidence
+    title: 证据合并
+    owner: integration
+    kind: artifact
+    status: pending
+    parallelGroup: reduce
+    dependsOn: [test-map-shards]
+  - id: acceptance
+    title: 验收
+    owner: verifier
+    kind: acceptance
+    status: pending
+`;
+
+function flowOf(text = CONSISTENT_FLOW) {
+  const parsed = parseFlowStateYaml(text, "flow-a");
