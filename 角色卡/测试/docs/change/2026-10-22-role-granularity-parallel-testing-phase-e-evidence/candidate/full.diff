+  for (const key of Object.keys(MODULE_TABLE_PATTERNS) as Array<keyof typeof MODULE_TABLE_PATTERNS>) {
+    const index = header.findIndex((cell) => MODULE_TABLE_PATTERNS[key].test(cell));
+    if (index !== -1) columnOf[key] = index;
