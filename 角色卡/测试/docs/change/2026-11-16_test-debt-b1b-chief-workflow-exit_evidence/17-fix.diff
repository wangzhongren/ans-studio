+// server 让 node --test 的文件子进程永不退出。修复口径（同 B1）：清理步骤互相隔离、server 必关、
+// 每个清理 await 有界；文件级 after() 再兜底关闭任何遗漏的夹具 server。清理失败不改变用例断言
+// 结果（只输出诊断），确保失败名与基线逐名一致；断言文本/语义未放宽。
+const fixtureServers = new Set<Server>();
+function trackedServer(server: Server): Server { fixtureServers.add(server); return server; }
+// 本文件所有夹具 server 统一经此工厂创建（调用点不变），保证文件级 after() 能兜底关闭。
+const createServer = ((handler: Parameters<typeof rawCreateServer>[0]) => trackedServer(rawCreateServer(handler))) as typeof rawCreateServer;
+async function closeServer(server: Server): Promise<void> {
+  try { server.closeAllConnections(); } catch { /* 未监听/已关闭 */ }
+  if (!server.listening) return;
+  await new Promise<void>(resolve => { try { server.close(() => resolve()); } catch { resolve(); } });
+}
+type CleanupStep = readonly [label: string, run: () => unknown];
+async function releaseAll(context: string, steps: readonly CleanupStep[]): Promise<void> {
+  const failures: string[] = [];
+  for (const [label, run] of steps) {
+    try { await run(); } catch (error) { failures.push(`${label}: ${error instanceof Error ? error.message : String(error)}`); }
+  }
+  if (failures.length > 0) console.error(`B1b cleanup retained for ${context}: ${failures.join(" | ")}`);
+}
+async function settleBounded(context: string, work: Promise<unknown>, timeoutMs: number): Promise<void> {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const deadline = new Promise<void>(resolve => { timer = setTimeout(() => { console.error(`B1b ${context} exceeded ${timeoutMs}ms`); resolve(); }, timeoutMs); });
+  try { await Promise.race([work, deadline]); } finally { if (timer !== undefined) clearTimeout(timer); }
+}
+async function stopManagerBounded(manager: { stop(target: null): Promise<unknown> } | undefined, context: string, timeoutMs = 15_000): Promise<void> {
+  if (!manager) return;
+  await settleBounded(`${context} manager.stop`, manager.stop(null), timeoutMs);
+}
+async function disposeDocumentsBounded(desktop: { disposeProjectDocuments(): void } | undefined, context: string): Promise<void> {
+  if (!desktop) return;
+  // 在途 dispatch 可能暂占 Git host coordinator；有界重试让清理自身完成，而不是无限持有夹具 server。
+  let lastError: unknown;
+  for (const wait of [0, 50, 200, 800]) {
+    if (wait > 0) await tick(wait);
+    try { desktop.disposeProjectDocuments(); return; } catch (error) { lastError = error; }
+  }
+  console.error(`B1b disposeProjectDocuments retained for ${context}: ${lastError instanceof Error ? lastError.message : String(lastError)}`);
+}
+after(async () => {
