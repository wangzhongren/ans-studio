+/** 只看选项位置；选项可出现在位置参数后，直到 --。短选项组合的首个带值项吃掉余部或下一项。 */
+function hasRgPreprocessor(args: string[]): boolean {
+  for (let i = 1; i < args.length; i++) {
+    const arg = args[i];
+    if (arg === "--") break;
