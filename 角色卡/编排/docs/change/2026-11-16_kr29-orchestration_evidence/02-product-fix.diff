+// `sessionDirFor` 一直显式支持空 projectRoot（不传 sessionDir/不预建 .ans，见 4466-4469）。
+// e71501c 引入 Git 保护面后，`readGitProtectionFacts("")` 会对空串 realpath('') 抛 ENOENT，
+// 把旧支持的形态变成会话构造前失败（KR-29 #14 产品回归，CI 两平台同错）。
+// 最小修复：仅当根为空（trim 后）时短路——不做主机探测，按 unmanaged/无保护根返回；
+// 非空根仍走真实探测与 fail-closed 判定，语义逐字不变。
+function isBlankProjectRoot(projectRoot: string): boolean {
+  return typeof projectRoot !== "string" || projectRoot.trim() === "";
+}
+/** 空根的 Git 保护事实：不 realpath、无保护根；与无 `.git` 根同形的安全空集（非探测结果，故 coverage=unknown）。 */
+function blankRootGitProtectionFacts(): GitProtectionFacts {
+  return { projectRoot: "", protectedGitRoots: [], coverage: "unknown", basisDigest: "blank-project-root-unmanaged", reasons: ["blank-project-root-unmanaged"] };
+}
+/** 空根的主机保护要求：与无 `.git`/无 trunk 状态的根同形（unmanaged）。 */
+const BLANK_ROOT_HOST_PROTECTION = { state: "unmanaged", revision: 0, reasons: [] } as const satisfies {
+  state: "required" | "unmanaged" | "unknown"; revision: number; reasons: readonly string[];
+};
