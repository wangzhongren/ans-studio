+  if (roleId.trim() === "") return "角色 id 不能为空";
+  if (roleId !== roleId.trim()) return `角色 id 不能含首尾空白（"${roleId}"）`;
+  if (roleId === "." || roleId === "..") return `角色 id 不能是 "${roleId}"`;
