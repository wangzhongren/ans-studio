+
+for (const format of ["sha1", "sha256"] as const) test(`W2 actual ${format} bootstrap 9 文件快照（8 frozen 含 intent v1 + versions）：闭包只要求 frozen，candidate/publication 均 allowed（T10/T13）`, async t => {
+  const fixture = await freezeClosureFixture(format); t.after(() => fs.rm(fixture.root, { recursive: true, force: true }));
