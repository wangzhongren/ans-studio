+  const digest = sha("W2 unit service-checked target digest");
+  const freeze = (id: string) => ({ schema: "doc-freeze/v1", applicationId: id, reason: "bootstrap-vca-approved", origin: "application", frozenAt: at });
+
+  const intentV1: Doc = { path: "docs/product/unit-intent-v1.md", text: "Unit intent v1 bytes\n", doc: "intent", canonical: "docs/product/unit-intent", version: 1 };
+  const proposalV1: Doc = { path: "docs/proposals/unit-proposal-v1.md", text: "Unit proposal v1 bytes\n", doc: "proposal", canonical: "docs/proposals/unit-proposal", version: 1 };
+  const proposalV2: Doc = { path: "docs/proposals/unit-proposal-v2.md", text: "Unit proposal v2 current bytes\n", doc: "proposal", canonical: "docs/proposals/unit-proposal", version: 2 };
+  const architectureV1: Doc = { path: "docs/contracts/unit-architecture-v1.md", text: "Unit architecture v1 bytes\n", doc: "architecture", canonical: "docs/contracts/unit-architecture", version: 1 };
+  const architectureV2: Doc = { path: "docs/contracts/unit-architecture-v2.md", text: "Unit architecture v2 bytes\n", doc: "architecture", canonical: "docs/contracts/unit-architecture", version: 2 };
+  const rosterV1: Doc = { path: "docs/proposals/unit-roster-v1.md", text: "Unit roster v1 bytes\n", doc: "roster", canonical: "docs/proposals/unit-roster", version: 1 };
+  const rosterV2: Doc = { path: "docs/proposals/unit-roster-v2.md", text: "Unit roster v2 bytes\n", doc: "roster", canonical: "docs/proposals/unit-roster", version: 2 };
+  const modulesV1: Doc = { path: "docs/proposals/unit-modules-v1.md", text: "Unit modules v1 bytes\n", doc: "modules", canonical: "docs/proposals/unit-modules", version: 1 };
+  const frozenDocs = [intentV1, proposalV1, proposalV2, architectureV1, architectureV2, rosterV1, rosterV2, modulesV1];
+  const frozenRow = (doc: Doc, actualPath = false): LedgerRow => ({ v: 1, flowId, doc: doc.doc, version: doc.version,
+    path: actualPath ? doc.path : doc.canonical, sha256: sha(doc.text), recordedAt: at, recordedBy: "app:session", event: "frozen",
+    freeze: freeze(`freeze-${doc.doc}-v${doc.version}`) });
+  // architecture v1 记录使用「path 已是实际 -vN.md」的旧口径（门禁 :728 原样使用路径）。
+  const frozenRows: LedgerRow[] = [frozenRow(intentV1), frozenRow(proposalV1), frozenRow(proposalV2), frozenRow(architectureV1, true),
+    frozenRow(architectureV2), frozenRow(rosterV1), frozenRow(rosterV2), frozenRow(modulesV1)];
+  // 5 条非 frozen 历史草稿行：旧 sha 从未冻结、已被原位覆盖，磁盘与快照均不存在（旧谓词不可满足）。
+  const draftRows: LedgerRow[] = [
+    { v: 1, flowId, doc: "proposal", version: 2, path: "docs/proposals/unit-proposal", sha256: sha("proposal baseline old bytes"), recordedAt: at, recordedBy: "app:session", event: "baseline" },
+    { v: 1, flowId, doc: "proposal", version: 2, path: "docs/proposals/unit-proposal", sha256: sha("proposal draft-updated old bytes"), recordedAt: at, recordedBy: "app:session", event: "draft-updated" },
+    { v: 1, flowId, doc: "roster", version: 2, path: "docs/proposals/unit-roster", sha256: sha("roster version-added old bytes"), recordedAt: at, recordedBy: "app:session", event: "version-added" },
+    { v: 1, flowId, doc: "modules", version: 1, path: "docs/proposals/unit-modules", sha256: sha("modules draft-marker old bytes"), recordedAt: at, recordedBy: "app:session", event: "draft-marker" },
+    { v: 1, flowId, doc: "intent", version: 1, path: "docs/product/unit-intent", sha256: sha("intent baseline old bytes"), recordedAt: at, recordedBy: "app:session", event: "baseline" },
+  ];
+  const baseRows: LedgerRow[] = [...frozenRows, ...draftRows];
+
+  type Options = {
+    rows?: readonly LedgerRow[];
+    versionsText?: string;
+    removePaths?: readonly string[];
+    extraFiles?: readonly { path: string; text: string }[];
+    drift?: { path: string; text: string };
+    executablePaths?: readonly string[];
+  };
