+test("W2 未知/非法 event/freeze、坏记录与异 flow 行仍 fail-closed，不静默过滤（T12/T17）", async t => {
+  const fixture = await freezeClosureFixture("sha1"); t.after(() => fs.rm(fixture.root, { recursive: true, force: true }));
+  const architectureV1 = fixture.frozenRows.find(row => row.doc === "architecture" && row.version === 1)!;
+  const replaceFrozen = (patch: LedgerRow) => fixture.baseRows.map(row => row === architectureV1 ? { ...row, ...patch } : row);
+  const cases: [LedgerRow[], string][] = [
+    [replaceFrozen({ event: "future-event" }), "git-policy-app-freeze-source"],
+    [replaceFrozen({ freeze: undefined }), "git-policy-app-freeze-source"],
+    [replaceFrozen({ freeze: { schema: "doc-freeze/v1" } }), "git-policy-app-freeze-source"],
