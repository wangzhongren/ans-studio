+    content.set(`.ans/trunk/snapshots/${snapshot.snapshotId}.json`, Buffer.from(JSON.stringify(snapshot)));
+    const plan = await objects.plan({ operationId, base: null, timestamp: at, message: `ANS trunk 1 ${digest}`,
+      files: [...content].map(([file, bytes]) => ({ path: file, bytesBase64: bytes.toString("base64"), ...(options.executablePaths?.includes(file) ? { executable: true } : {}) })) });
+    return { repoId: identity.repoId, operationId, actorRoleId: "product", taskId: "w2-freeze-closure-task", authorizationRevision: 7, currentAuthorizationRevision: 7,
+      objectFormat: format, template: "commit", paths: [...content.keys()], readPaths: ["."], writePaths: ["docs/product/"], base: null,
+      candidate: plan.commit.candidate, ref: plan.ref, ownedCandidateRef: plan.ref, worksite: plan.worksite, rawObjectPlan: plan, argv: plan.commands[0]!, commands: plan.commands,
+      allDiff: { complete: true, base: null, candidate: plan.commit.candidate, entries: plan.diff },
+      businessPublication: { kind: "direct-document-publication", flowId, operationId, actorRoleId: "product", applicationId, action: "version-upgrade",
