+    for (const extra of options.extraFiles ?? []) contents.set(extra.path, extra.text);
+    if (options.drift) contents.set(options.drift.path, options.drift.text);
+    const versionsText = options.versionsText ?? `${(options.rows ?? baseRows).map(row => JSON.stringify(row)).join("\n")}\n`;
+    contents.set(".ans/state/versions.jsonl", versionsText);
+    const documents = { proposal: { path: proposalV2.path, sha256: sha(proposalV2.text), version: proposalV2.version } };
+    const execution = { teamPlan: null, flow: null };
+    const snapshotFiles = [...contents].map(([file, text]) => ({ path: file, sha256: sha(text), bytesBase64: Buffer.from(text).toString("base64") }));
+    const snapshot = testSnapshot(`s-${sha("unit-freeze-closure-snapshot")}`, snapshotFiles, at);
+    const snapshotRef = { snapshotId: snapshot.snapshotId, digest: snapshot.digest };
+    const source = { kind: "role-direct" as const, action: "version-upgrade" as const, actorRoleId: "product", operationId, applicationId, baseDigest: null, targetDigest: digest, at, journalId: "unit-freeze-journal" };
+    const manifest: TrunkManifest = { schema: "trunk/v1", trunkVersion: 1, source: "upgrade", previous: null, flowId, runId: null,
+      artifacts: { documents, execution, boundaries: {} }, digest, createdAt: at, updatedAt: at, snapshotRef, actionSource: source };
+    const journal: TrunkApplyJournal = { v: 1, schema: "trunk-apply-journal/v1", journalId: source.journalId, operationId, applicationId, flowId, phase: "prepared",
+      actionSource: source, targetSnapshot: snapshotRef, startedAt: at, updatedAt: at,
+      target: { trunkVersion: 1, runId: null, documents: { proposal: { path: proposalV2.path, sha256: sha(proposalV2.text) } }, execution },
