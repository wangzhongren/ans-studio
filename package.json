{
  "name": "ans-cli",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "受治理会话链路 CLI（v1 原型）：解析角色/边界 -> 受治理工具集 -> 写入前拦截。",
  "type": "module",
  "bin": {
    "ans": "bin/ans.js"
  },
  "main": "app/main.ts",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node bin/ans.js",
    "doctor": "node bin/ans.js doctor",
    "demo": "node bin/ans.js role run 编排 --task T-1",
    "app": "electron app/main.ts",
    "test:assembly": "node --test \"test/装配/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "package": "electron-builder --config electron-builder.yml",
    "release:prepare": "node src/common/装配/release-prepare.mjs",
    "release:verify": "node src/common/装配/release-verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@anthropic-ai/sdk": "0.93.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex": "0.162.1",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2"
  }
}
