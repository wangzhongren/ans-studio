{
  "name": "ans-cli",
  "version": "1.8.0",
  "private": true,
  "license": "MIT",
  "description": "受治理会话链路 CLI（v1 原型）：解析角色/边界 -> 受治理工具集 -> 写入前拦截。",
  "type": "module",
  "bin": {
    "ans": "bin/ans.js"
  },
  "main": "app/main.ts",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node bin/ans.js",
    "doctor": "node bin/ans.js doctor",
    "demo": "node bin/ans.js role run 编排 --task T-1",
    "app": "electron app/main.ts",
    "test:assembly": "node --test \"test/装配/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc -p app/renderer/tsconfig.json",
    "dev:renderer": "vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "preview:renderer": "vite preview --config vite.config.ts",
    "package": "electron-builder --config electron-builder.yml",
    "package:local": "npm run build:renderer && electron-builder --config electron-builder.yml --publish never -c.directories.output=release-output/local",
    "verify:local": "node test/装配/verify-local-package.mjs",
    "release:prepare": "node src/common/装配/release-prepare.mjs",
    "release:verify": "node src/common/装配/release-verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@anthropic-ai/sdk": "0.93.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex": "0.162.1",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "lucide-react": "1.60.0",
    "markdown-it": "15.0.3",
    "motion": "14.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  }
}
